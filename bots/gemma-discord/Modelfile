{{ else if eq .Role "assistant" }}{{ .Content }}<end_of_turn>
{{ else if eq .Role "tool" }}<start_of_turn>tool
{{ .Content }}<end_of_turn>
<start_of_turn>model
{{ end }}{{ end }}"""

