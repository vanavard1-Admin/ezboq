# Gemma 4 uses <start_of_turn> / <end_of_turn> tokens natively.
# Tool calls are formatted as JSON inside <tool_call> tags so the bot.mjs
# parser (which already expects Ollama's tool_calls array) can intercept them.
TEMPLATE """{{ if .System }}<start_of_turn>system
{{ .System }}<end_of_turn>
{{ end }}{{ range .Messages }}{{ if eq .Role "user" }}<start_of_turn>user
{{ .Content }}<end_of_turn>
