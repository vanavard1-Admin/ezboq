rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // PDF files - no direct public access
    // Access only via signed URLs generated by Cloud Functions
    match /users/{userId}/businesses/{businessId}/documents/{fileName} {
      allow read, write: if false;
    }

    match /users/{userId}/businesses/{businessId}/assets/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ✅ CRITICAL: Payment QR codes and slips - server-only access
    // These contain sensitive payment information
    match /payment-qr/{fileName} {
      allow read, write: if false; // Server-only (Cloud Functions generate signed URLs)
    }
    
    match /credit-slips/{fileName} {
      allow read, write: if false; // Server-only (Cloud Functions generate signed URLs)
    }
    
    // Business assets (logos, signatures, stamps) - server-only
    match /business-assets/{businessId}/{assetType}/{fileName} {
      allow read, write: if false; // Server-only
    }
    
    // Social media uploads - public read, authenticated write only
    match /social-media/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /uploads/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
