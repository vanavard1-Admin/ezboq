{
  "exclude": [
    "src/**/__tests__/**",
    "**/*.test.ts"
  ],
    "compilerOptions": {
        "module": "commonjs",
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "outDir": "dist",
        "sourceMap": true,
        "strict": true,
        "target": "ES2022",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "moduleResolution": "node"
    },
    "compileOnSave": true,
    "include": [
        "src"
    ]
}