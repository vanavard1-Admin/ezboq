{
  "name": "ezdoc-functions",
  "version": "1.0.0",
  "description": "EzDoc Firebase Cloud Functions - LINE Webhook + Core Logic",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/jarvis/knowledge-base.json dist/jarvis/knowledge-base.json",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "lint": "node ../node_modules/eslint/bin/eslint.js \"src/**/*.ts\" --ignore-pattern '**/__tests__/**' --ignore-pattern '**/*.test.ts'",
    "lint:all": "node ../node_modules/eslint/bin/eslint.js \"src/**/*.ts\"",
    "lint:staging": "node ../node_modules/eslint/bin/eslint.js \"src/**/*.ts\" || true"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google-cloud/speech": "^7.3.0",
    "@google-cloud/tasks": "^5.5.0",
    "@google-cloud/vision": "^5.3.4",
    "@google/generative-ai": "^0.24.1",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "axios": "^1.14.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.3.2",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.1.1",
    "google-auth-library": "^9.15.1",
    "jszip": "^3.10.1",
    "node-fetch": "^2.6.7",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.10",
    "@types/node-fetch": "^2.6.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^8.57.1",
    "firebase-functions-test": "^3.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "private": true
}
